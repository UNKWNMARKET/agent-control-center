# ──────────────────────────────────────────────────────────────────────────
# LEAD MANAGEMENT — environment variables
# Copy this file to `.env` for local development, and add the same keys to
# Vercel (Project → Settings → Environment Variables) for production.
# ──────────────────────────────────────────────────────────────────────────

# Postgres connection (Supabase). The app connects as the dedicated `app_user`
# role. For LOCAL development the direct connection is fine:
DATABASE_URL="postgresql://app_user:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://app_user:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=public"

# For VERCEL, use the Supabase "Transaction pooler" connection string instead
# (IPv4-friendly, better for serverless). See README → "Deploy to Vercel".
# Example shape:
# DATABASE_URL="postgresql://app_user.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://app_user.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secret used to sign login session cookies. Generate with: openssl rand -hex 48
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL of the deployed app (used to display vendor webhook URLs).
# Local: http://localhost:3000   ·   Vercel: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email delivery for "forgot password" reset links (Resend — https://resend.com).
# Create a free account, add an API key, and verify a sender/domain. Leave blank
# to disable email sending (reset links are logged to the server console instead).
RESEND_API_KEY=""
RESET_EMAIL_FROM="Lead Management <noreply@yourdomain.com>"

# National DNC registry scrubbing (optional). Leave blank to check only your
# internal Do-Not-Call list. Sign up with a DNC scrub provider (e.g. RealValidation,
# Blacklist Alliance), then set DNC_API_URL to their GET-JSON endpoint template
# containing {phone} and {key}:
# DNC_API_URL="https://api.realvalidation.com/rpvWebService/DNCLookup.php?phone={phone}&token={key}&output=json"
DNC_API_KEY=""
DNC_API_URL=""

# SMS automation (Twilio). Leave blank to keep texting off. Create a Twilio
# account, buy a number, and complete A2P 10DLC registration for US business texting.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+1XXXXXXXXXX"
# Secret that protects the daily follow-up cron route (Vercel sends it automatically
# when set as an env var). Generate with: openssl rand -hex 24
CRON_SECRET=""
